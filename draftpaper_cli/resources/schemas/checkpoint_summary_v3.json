{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dpl.checkpoint_summary.v3",
  "title": "Draftpaper-loop checkpoint summary v3",
  "description": "A same-source, hash-bound summary for human review. Legacy v1/v2 summaries are readable but are not confirmation packages.",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "checkpoint_type",
    "completed_stage",
    "stage_status",
    "review_state",
    "stage_purpose_zh",
    "stage_narrative_zh",
    "stage_deliverables",
    "transaction_changes",
    "deliverable_groups",
    "deliverable_counts",
    "identity",
    "core_metrics",
    "sample_flow",
    "validation_summary",
    "consistency_checks",
    "decision_routes",
    "decision_route_state",
    "inspection_targets",
    "artifact_manifest",
    "artifact_manifest_sha256",
    "confirmation_contract",
    "confirmation_meaning_zh",
    "rejection_or_refinement_route_zh",
    "generated",
    "modified",
    "deployed",
    "validated",
    "failed",
    "unresolved",
    "scientific_summary_zh",
    "scientific_impact",
    "test_mode",
    "test_auto_confirmation",
    "stage_summary_path",
    "artifact_manifest_path",
    "stage_summary_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "dpl.checkpoint_summary.v3"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "checkpoint_type": {"type": "string", "minLength": 1},
    "completed_stage": {"type": "string", "minLength": 1},
    "stage_status": {"enum": ["ready_for_human_review", "blocked"]},
    "review_state": {"enum": ["confirmable", "stale", "blocked", "preview_only"]},
    "stage_purpose_zh": {"type": "string", "minLength": 1},
    "stage_narrative_zh": {"type": "string", "minLength": 1},
    "stage_deliverables": {"type": "array"},
    "transaction_changes": {"type": "object"},
    "deliverable_groups": {"type": "array"},
    "deliverable_counts": {"type": "object"},
    "identity": {"type": "object"},
    "core_metrics": {"type": "object"},
    "sample_flow": {"type": "array"},
    "validation_summary": {"type": "array"},
    "consistency_checks": {"type": "array"},
    "decision_routes": {"type": "array"},
    "decision_route_state": {"type": "object"},
    "inspection_targets": {"type": "array"},
    "artifact_manifest": {"type": "object"},
    "artifact_manifest_sha256": {"type": "string", "minLength": 1},
    "confirmation_contract": {
      "type": "object",
      "required": ["requires_user_decision", "confirmation_command_allowed", "source_of_truth", "test_auto_confirmation"],
      "properties": {
        "requires_user_decision": {"const": true},
        "confirmation_command_allowed": {"type": "boolean"},
        "source_of_truth": {"const": "canonical_evidence"},
        "test_auto_confirmation": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "confirmation_meaning_zh": {"type": "string", "minLength": 1},
    "rejection_or_refinement_route_zh": {"type": "string", "minLength": 1},
    "generated": {"type": "array"},
    "modified": {"type": "array"},
    "deployed": {"type": "array"},
    "validated": {"type": "array"},
    "failed": {"type": "array"},
    "unresolved": {"type": "array"},
    "scientific_summary_zh": {"type": "array"},
    "scientific_impact": {"type": "array"},
    "test_mode": {"type": "boolean"},
    "test_auto_confirmation": {"type": "boolean"},
    "stage_summary_path": {"type": "string", "minLength": 1},
    "artifact_manifest_path": {"type": "string", "minLength": 1},
    "stage_summary_sha256": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
