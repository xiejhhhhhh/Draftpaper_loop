  "properties": {
    "schema_version": {"const": "dpl.checkpoint_summary.v4"},
    "review_requirement": {"enum": ["notify_only", "agent_delegable", "human_required"]},
    "decision_status": {"type": "string"},
    "decision_actor_type": {"enum": ["none", "system", "agent", "user"]},
    "risk_class": {"enum": ["C0", "C1", "C2", "C3"]},
    "stage_activity_bundle": {"type": "object"},
    "baseline_refs": {"type": "object"}
  },
  "additionalProperties": true
}
