{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dpl.checkpoint_summary.v2",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "checkpoint_type",
    "stage_summary_sha256",
    "artifact_manifest_sha256",
    "review_state",
    "stage_narrative_zh",
    "stage_deliverables",
    "transaction_changes",
    "deliverable_groups",
    "validation_summary",
    "consistency_checks",
    "generated",
    "modified",
    "deployed",
    "validated",
    "failed",
    "unresolved"
  ],
  "properties": {
    "schema_version": {"const": "dpl.checkpoint_summary.v2"},
    "checkpoint_id": {"type": "string"},
    "checkpoint_type": {"type": "string"},
    "stage_summary_sha256": {"type": "string"},
    "artifact_manifest_sha256": {"type": "string"},
    "review_state": {"enum": ["confirmable", "stale", "blocked", "preview_only"]},
    "stage_narrative_zh": {"type": "string"},
    "stage_deliverables": {"type": "array"},
    "transaction_changes": {"type": "object"},
    "deliverable_groups": {"type": "array"},
    "validation_summary": {"type": "array"},
    "consistency_checks": {"type": "array"},
    "generated": {"type": "array"},
    "modified": {"type": "array"},
    "deployed": {"type": "array"},
    "validated": {"type": "array"},
    "failed": {"type": "array"},
    "unresolved": {"type": "array"},
    "test_auto_confirmation": {"type": "boolean"}
  },
  "additionalProperties": true
}
