    "checkpoint_type": {"type": "string"},
    "decision_id": {"type": "string"},
    "decision_question": {"type": "object"},
    "facts": {"type": "array", "minItems": 1},
    "confirming": {"type": "array", "minItems": 1},
    "not_confirming": {"type": "array", "minItems": 1},
    "reopen_conditions": {"type": "array", "minItems": 1},
    "semantic_subject": {"type": "object"},
    "brief_semantic_sha256": {"type": "string"}
  },
  "additionalProperties": true
}
